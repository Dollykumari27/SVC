function p = initialize_parameters()

%% SNR
p.snr_db = 0:2:20;
p.snr    = 10.^(p.snr_db/10);

%% Channel
p.channel_mode = 3;       % EPA

%% SVC parameters
p.bi     = 12;
p.m      = 42;
p.K      = 2;

%% MMP parameters
p.Lmmp = 4;
p.lmax = p.Lmmp^p.K;
%% Receive antennas
p.Nr = 2;
%% Monte-Carlo simulation
p.nTrials = 1e4;
end
